{
  "name": "mi-cv-con-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Backend & AI orchestration for Mi CV con IA — Spanish-language AI resume builder",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:reset": "supabase db reset",
    "demo:seed": "vite-node --config vitest.config.ts scripts/seed-talent-demo.ts --",
    "demo:seed:clean": "vite-node --config vitest.config.ts scripts/seed-talent-demo.ts -- --clean",
    "resume:list": "vite-node --config vitest.config.ts scripts/delete-resume.ts -- --list",
    "resume:delete": "vite-node --config vitest.config.ts scripts/delete-resume.ts --",
    "resume:costs": "vite-node --config vitest.config.ts scripts/delete-resume.ts -- --costs",
    "resume:orphans": "vite-node --config vitest.config.ts scripts/delete-resume.ts -- --orphans"
  },
  "dependencies": {
    "@sparticuz/chromium": "^148.0.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^14.2.35",
    "openai": "^7.4.0",
    "puppeteer-core": "^24.43.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "puppeteer": "^23.11.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
